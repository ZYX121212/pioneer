# Optional. Used for canonical URLs, RSS, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated verified site-owner emails; server-only administrator allowlist.
ADMIN_EMAILS=

# Optional server-only Resend mail delivery. Set as Sites runtime secrets/config.
# Keep disabled until the sender domain and real test delivery have been verified.
RESEND_API_KEY=
MAIL_FROM=
MAIL_SITE_ORIGIN=https://pioneer-global-resources.hiayun.chatgpt.site
MAIL_DELIVERY_ENABLED=false

# Optional independent provider for account verification/password recovery.
# Brevo: verify ACCOUNT_MAIL_FROM and real delivery before enabling.
# Newsletter delivery above remains separate and uses Resend.
ACCOUNT_MAIL_PROVIDER=resend
BREVO_API_KEY=
ACCOUNT_MAIL_FROM=
ACCOUNT_MAIL_DELIVERY_ENABLED=false

# Required server-only email/password auth signing secret (32+ random characters).
# Store as a Sites runtime secret. Never commit a real value.
PIONEER_AUTH_SECRET=
# Local development only. Production defaults to the published Site origin.
PIONEER_AUTH_ORIGIN=http://localhost:3000
